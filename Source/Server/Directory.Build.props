<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>Preview</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <UseWindowsForms>true</UseWindowsForms>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <Company>Vita-Nex</Company>
    <Authors>Voxpire</Authors>
    <AssemblyVersion>1.3.3.7</AssemblyVersion>
    <FileVersion>1.3.3.7</FileVersion>
    <Copyright>© 2026</Copyright>
    <Description>Game Server Software</Description>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);NEWTIMERS;NEWPARENT;AVOX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
</Project>